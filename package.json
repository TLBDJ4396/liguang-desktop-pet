{
  "name": "liguang-pet",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "allowScripts": {
    "electron@30.5.1": true
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7",
    "systeminformation": "^5.33.13"
  },
  "build": {
    "appId": "com.liguang.pet",
    "productName": "璃光",
    "directories": {
      "output": "D:/grrj"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/.cache/**/*",
      "!**/*.md",
      "!**/*.log",
      "!package.json.bak"
    ],
    "extraResources": [
      { "from": "assets", "to": "assets" }
    ],
    "win": {
      "target": ["dir"],
      "icon": "assets/icon.ico"
    },
    "asarUnpack": [
      "**/node_modules/systeminformation/**/*"
    ]
  }
}
